{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
        "jsx": "react-native",
        "types": ["react", "react-native"],
		"moduleResolution": "node",
		"paths": {
			"@/*": ["./*"]
		}
	},
    "include": [
        "app",
        "components",
        "utils",
        "assets",
        "styles",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "eslint.config.js"
    ]
}
